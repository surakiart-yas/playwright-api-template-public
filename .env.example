# === Required ===
# Default points at the bundled mock server (mocks/server.ts) so `pnpm test`
# is green on a fresh clone. Replace with your real API URL when targeting
# dev/staging/prod (and use `pnpm test:dev` / `:staging` / `:prod`).
API_BASE_URL=http://localhost:4010/api

# === Auth ===
# Set directly to skip global-setup login (fastest option)
API_AUTH_TOKEN=
# Used by global-setup to acquire token automatically.
# Defaults below match the seeded admin in mocks/server.ts.
API_ADMIN_USERNAME=admin@example.com
API_ADMIN_PASSWORD=Admin@123456

# === Performance ===
API_MAX_RESPONSE_MS=5000

# === Runner ===
# Set to `true` for verbose HTTP logging during test development.
# Default off so first `pnpm test` after clone isn't drowned in logs.
DEBUG_API=false

# === Mock server (only used when TEST_ENV is unset or "local") ===
MOCK_PORT=4010
