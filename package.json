{
  "name": "playwright-api-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "mock": "tsx mocks/server.ts",
    "test": "playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:debug": "cross-env DEBUG_API=true playwright test",
    "report": "playwright show-report",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'mocks/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts' 'mocks/**/*.ts'",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "verify": "pnpm lint && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "hono": "^4.12.23",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2"
  },
  "packageManager": "pnpm@10.18.0"
}
